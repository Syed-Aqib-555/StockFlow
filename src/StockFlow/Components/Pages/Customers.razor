@page "/customers"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<PageTitle>Customers · StockFlow</PageTitle>
<div class="page-heading"><div><p class="eyebrow">CUSTOMER BOOK</p><h1>Customers</h1><p>Contact details and complete purchase history in one place.</p></div><button class="btn btn-accent" @onclick="()=>showForm=!showForm">＋ Add customer</button></div>
@if(!string.IsNullOrWhiteSpace(message)){<div class="alert alert-success">@message</div>}@if(!string.IsNullOrWhiteSpace(error)){<div class="alert alert-danger">@error</div>}
@if(showForm){<EditForm Model="form" OnValidSubmit="AddAsync"><DataAnnotationsValidator/><section class="form-card"><div class="panel-title"><div><h2>New customer</h2><p>Add contact information now; sales will appear automatically.</p></div><button type="button" class="btn btn-outline btn-sm" @onclick="()=>showForm=false">Close</button></div><div class="form-grid"><div><label class="form-label">Full name</label><InputText class="form-control" @bind-Value="form.Name"/><ValidationMessage For="@(()=>form.Name)"/></div><div><label class="form-label">Phone</label><InputText class="form-control" @bind-Value="form.Phone"/></div><div class="full"><label class="form-label">Email</label><InputText class="form-control" @bind-Value="form.Email"/><ValidationMessage For="@(()=>form.Email)"/></div></div><button class="btn btn-accent mt-3" type="submit">Save customer</button></section></EditForm>}
<section class="data-panel">
    <div class="toolbar"><div class="search-box"><input class="form-control" @bind="search" @bind:event="oninput" placeholder="Search name, phone, or email…"/></div><span class="muted">@Filtered.Count() customers</span></div>
    <div class="table-wrap"><table class="sf-table"><thead><tr><th>Customer</th><th>Phone</th><th>Orders</th><th>Total spent</th><th>Last purchase</th><th></th></tr></thead><tbody>@foreach(var customer in Filtered){var completed=customer.Sales.Where(x=>x.Status==SaleStatus.Completed).ToList();<tr><td><div class="cell-product"><span class="profile-avatar">@Initial(customer.Name)</span><div><strong>@customer.Name</strong><small>@customer.Email</small></div></div></td><td>@customer.Phone</td><td>@completed.Count</td><td class="money">$@completed.Sum(x=>x.Total).ToString("N2")</td><td>@(completed.Count==0?"—":completed.Max(x=>x.Date).ToLocalTime().ToString("dd MMM yyyy"))</td><td><button class="btn btn-outline btn-sm" @onclick="()=>selected=customer">History</button></td></tr>}</tbody></table></div>
</section>
@if(selected is not null){<section class="data-panel mt-3"><div class="toolbar"><div><strong>@selected.Name · Purchase history</strong><div class="muted mt-1">@selected.Phone · @selected.Email</div></div><button class="btn btn-outline btn-sm" @onclick="()=>selected=null">Close</button></div><div class="table-wrap"><table class="sf-table"><thead><tr><th>Invoice</th><th>Date</th><th>Items</th><th>Payment</th><th>Total</th><th>Status</th></tr></thead><tbody>@foreach(var sale in selected.Sales.OrderByDescending(x=>x.Date)){<tr><td><a href="orders/@sale.Id">@sale.SaleNumber</a></td><td>@sale.Date.ToLocalTime().ToString("dd MMM yyyy")</td><td>@sale.Items.Sum(x=>x.Quantity)</td><td>@sale.PaymentMethod</td><td class="money">$@sale.Total.ToString("N2")</td><td><span class="status @(sale.Status==SaleStatus.Completed?"success":"danger")">@sale.Status</span></td></tr>}</tbody></table></div></section>}

@code{
    private List<Customer> customers=[];private string search="";private bool showForm;private Customer? selected;private CustomerForm form=new();private string? message,error;
    private IEnumerable<Customer> Filtered=>customers.Where(x=>string.IsNullOrWhiteSpace(search)||x.Name.Contains(search,StringComparison.OrdinalIgnoreCase)||(x.Phone?.Contains(search,StringComparison.OrdinalIgnoreCase)??false)||(x.Email?.Contains(search,StringComparison.OrdinalIgnoreCase)??false));
    protected override async Task OnInitializedAsync()=>await LoadAsync();private async Task LoadAsync(){await using var db=await DbFactory.CreateDbContextAsync();customers=await db.Customers.AsNoTracking().Include(x=>x.Sales).ThenInclude(x=>x.Items).OrderBy(x=>x.Name).ToListAsync();}
    private async Task AddAsync(){message=error=null;try{await using var db=await DbFactory.CreateDbContextAsync();db.Customers.Add(new Customer{Name=form.Name.Trim(),Phone=form.Phone?.Trim(),Email=form.Email?.Trim()});await db.SaveChangesAsync();form=new();showForm=false;message="Customer saved and ready to use at checkout.";await LoadAsync();}catch(Exception ex){error=ex.Message;}}
    private static string Initial(string value)=>string.Join("",value.Split(' ',StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x=>x[0])).ToUpperInvariant();
    private sealed class CustomerForm{[Required,StringLength(120)]public string Name{get;set;}="";[StringLength(30)]public string? Phone{get;set;}[EmailAddress,StringLength(160)]public string? Email{get;set;}}
}

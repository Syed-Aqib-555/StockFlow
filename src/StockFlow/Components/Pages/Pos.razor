@page "/pos"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin,Cashier")]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject PosService PosService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>Point of Sale · StockFlow</PageTitle>
<div class="page-heading"><div><p class="eyebrow">COUNTER · READY</p><h1>Point of Sale</h1><p>Search, select a variant, and complete the sale in one flow.</p></div><a class="btn btn-outline" href="orders">Today’s orders →</a></div>
@if(!string.IsNullOrWhiteSpace(error)){<div class="alert alert-danger">@error</div>}
<div class="pos-context">
    <span class="pos-ready"><i></i> Checkout ready</span>
    <span>@variants.Count active variants</span>
    <span>@variants.Count(x => x.QuantityOnHand > 0) available to sell</span>
</div>
<div class="pos-layout">
    <section class="catalog-panel">
        <div class="search-box"><input class="form-control" aria-label="Search the POS catalog" @bind="search" @bind:event="oninput" placeholder="Search product, SKU, color, or scan barcode…" autofocus /></div>
        <div class="category-pills"><button class="pill @(categoryId==0?"active":"")" @onclick="()=>categoryId=0">All products</button>@foreach(var category in categories){<button class="pill @(categoryId==category.Id?"active":"")" @onclick="()=>categoryId=category.Id">@category.Name</button>}</div>
        <div class="product-grid">
        @foreach(var item in FilteredVariants)
        {
            <button class="product-tile" aria-label="Add @item.Product.Name, @item.Size, @item.Color to the cart" disabled="@(item.QuantityOnHand==0)" @onclick="()=>Add(item)">
                <span class="tile-stock">@(item.QuantityOnHand==0?"OUT":$"{item.QuantityOnHand} LEFT")</span><img src="@(item.Product.ImageUrl??"favicon.png")" alt="@item.Product.Name" /><div><strong>@item.Product.Name</strong><small>@item.Size · @item.Color · @item.Sku</small><b>$@item.SellingPrice.ToString("N2")</b></div>
            </button>
        }
        </div>
        @if(!FilteredVariants.Any()){<div class="empty-state">No available products match your search.</div>}
    </section>

    <aside class="cart-panel">
        <div class="cart-header"><h2>Current order</h2><span class="cart-count">@cart.Sum(x=>x.Quantity) ITEMS</span></div>
        <div class="cart-lines">
            @if(cart.Count==0){<div class="empty-state"><span class="empty-cart-mark">0</span><strong>Your cart is ready</strong><div class="mt-2">Choose an in-stock product to begin checkout.</div></div>}
            @foreach(var line in cart)
            {
                <div class="cart-line" @key="line.Variant.Id"><div><strong>@line.Variant.Product.Name</strong><small>@line.Variant.Size · @line.Variant.Color · @line.Variant.Sku</small><div class="qty-control"><button @onclick="()=>ChangeQuantity(line,-1)">−</button><b>@line.Quantity</b><button @onclick="()=>ChangeQuantity(line,1)">＋</button><button title="Remove" @onclick="()=>Remove(line)">×</button></div></div><b>$@((line.Quantity*line.Variant.SellingPrice).ToString("N2"))</b></div>
            }
        </div>
        <div class="cart-footer">
            <div class="form-grid"><div class="full"><label class="form-label">Customer</label><select class="form-select" @bind="customerId"><option value="">Walk-in customer</option>@foreach(var customer in customers){<option value="@customer.Id">@customer.Name · @customer.Phone</option>}</select></div><div><label class="form-label">Payment</label><select class="form-select" @bind="paymentMethod"><option value="Cash">Cash</option><option value="Card">Card</option></select></div><div><label class="form-label">Discount ($)</label><input class="form-control" type="number" min="0" step="0.01" @bind="discount" /></div></div>
            <div class="total-row"><span>Subtotal</span><strong>$@Subtotal.ToString("N2")</strong></div><div class="total-row"><span>Discount</span><span>− $@discount.ToString("N2")</span></div><div class="total-row grand"><span>Total</span><strong>$@Total.ToString("N2")</strong></div>
            <button class="btn btn-accent checkout-button" disabled="@(cart.Count==0||processing)" @onclick="CheckoutAsync"><span>@(processing?"Completing sale…":"Complete sale")</span><strong>$@Total.ToString("N2") →</strong></button>
        </div>
    </aside>
</div>

@code{
    private List<ProductVariant> variants=[];private List<Category> categories=[];private List<Customer> customers=[];private List<CartLine> cart=[];private string search="";private int categoryId;private int? customerId;private PaymentMethod paymentMethod=PaymentMethod.Cash;private decimal discount;private bool processing;private string? error;
    private decimal Subtotal=>cart.Sum(x=>x.Quantity*x.Variant.SellingPrice);private decimal Total=>Math.Max(0,Subtotal-discount);
    private IEnumerable<ProductVariant> FilteredVariants=>variants.Where(x=>categoryId==0||x.Product.CategoryId==categoryId).Where(x=>string.IsNullOrWhiteSpace(search)||x.Product.Name.Contains(search,StringComparison.OrdinalIgnoreCase)||x.Sku.Contains(search,StringComparison.OrdinalIgnoreCase)||x.Color.Contains(search,StringComparison.OrdinalIgnoreCase)||(x.Barcode?.Contains(search,StringComparison.OrdinalIgnoreCase)??false));
    protected override async Task OnInitializedAsync(){await using var db=await DbFactory.CreateDbContextAsync();variants=await db.ProductVariants.AsNoTracking().Include(x=>x.Product).Where(x=>x.IsActive&&x.Product.IsActive).OrderBy(x=>x.Product.Name).ToListAsync();categories=await db.Categories.AsNoTracking().OrderBy(x=>x.Name).ToListAsync();customers=await db.Customers.AsNoTracking().OrderBy(x=>x.Name).ToListAsync();}
    private void Add(ProductVariant variant){error=null;var line=cart.FirstOrDefault(x=>x.Variant.Id==variant.Id);if(line is null)cart.Add(new CartLine(variant));else if(line.Quantity<variant.QuantityOnHand)line.Quantity++;else error=$"Only {variant.QuantityOnHand} units are available.";}
    private void ChangeQuantity(CartLine line,int change){var next=line.Quantity+change;if(next<=0){cart.Remove(line);return;}if(next>line.Variant.QuantityOnHand){error=$"Only {line.Variant.QuantityOnHand} units are available.";return;}line.Quantity=next;}
    private void Remove(CartLine line)=>cart.Remove(line);
    private async Task CheckoutAsync(){error=null;if(discount<0||discount>Subtotal){error="Discount must be between zero and the subtotal.";return;}processing=true;try{var user=(await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;var userId=user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;var result=await PosService.CompleteSaleAsync(new CreateSaleRequest(cart.Select(x=>new CartLineRequest(x.Variant.Id,x.Quantity)).ToArray(),customerId,paymentMethod,discount),userId);Navigation.NavigateTo($"orders/{result.SaleId}");}catch(Exception ex){error=ex.Message;await OnInitializedAsync();}finally{processing=false;}}
    private sealed class CartLine(ProductVariant variant){public ProductVariant Variant{get;}=variant;public int Quantity{get;set;}=1;}
}

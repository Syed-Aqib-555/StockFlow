@inherits LayoutComponentBase

<div class="app-shell">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main class="main-panel">
        <header class="topbar">
            <div class="topbar-search">
                <span aria-hidden="true">⌕</span>
                <input aria-label="Quick search" placeholder="Search products, orders, or customers…" />
                <kbd>⌘ K</kbd>
            </div>
            <div class="topbar-actions">
                <a class="icon-button" href="inventory" title="Low stock alerts">♢</a>
                <AuthorizeView>
                    <Authorized>
                        <a class="user-chip" href="Account/Manage">
                            <span class="avatar">@(context.User.Identity?.Name?[0].ToString().ToUpperInvariant() ?? "S")</span>
                            <span><strong>@ShortName(context.User.Identity?.Name)</strong><small>Store team</small></span>
                        </a>
                    </Authorized>
                    <NotAuthorized>
                        <a class="btn btn-dark" href="Account/Login">Sign in</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </header>

        <article class="page-content">
            @Body
        </article>
    </main>
</div>

@code {
    private static string ShortName(string? email) =>
        string.IsNullOrWhiteSpace(email) ? "Team member" : email.Split('@')[0].Replace('.', ' ');
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

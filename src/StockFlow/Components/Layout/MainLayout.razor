@inherits LayoutComponentBase

<a class="skip-link" href="#main-content">Skip to main content</a>
<div class="app-shell">
    <aside class="sidebar">
        <NavMenu />
    </aside>

    <main class="main-panel">
        <header class="topbar">
            <form class="topbar-search" action="products" method="get" role="search">
                <span class="search-mark" aria-hidden="true"></span>
                <input name="q" aria-label="Search products and SKUs" placeholder="Search products or SKUs" autocomplete="off" />
                <kbd>/</kbd>
            </form>
            <div class="topbar-actions">
                <AuthorizeView>
                    <Authorized>
                        <span class="store-status"><i></i><span>Store online</span></span>
                        <a class="notification-button" href="inventory" aria-label="Open inventory alerts">
                            <span aria-hidden="true">!</span><i></i>
                        </a>
                        <a class="user-chip" href="Account/Manage">
                            <span class="avatar">@(context.User.Identity?.Name?[0].ToString().ToUpperInvariant() ?? "S")</span>
                            <span><strong>@ShortName(context.User.Identity?.Name)</strong><small>@(context.User.IsInRole("Admin") ? "Administrator" : "Cashier")</small></span>
                            <span class="chevron" aria-hidden="true">⌄</span>
                        </a>
                    </Authorized>
                    <NotAuthorized>
                        <a class="btn btn-dark" href="Account/Login">Sign in</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </header>

        <article class="page-content" id="main-content">
            @Body
        </article>
    </main>
</div>

@code {
    private static string ShortName(string? email) =>
        string.IsNullOrWhiteSpace(email) ? "Team member" : email.Split('@')[0].Replace('.', ' ');
}

<div id="blazor-error-ui" data-nosnippet>
    An unexpected error occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">×</span>
</div>

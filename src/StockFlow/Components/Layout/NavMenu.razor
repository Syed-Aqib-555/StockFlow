@implements IDisposable
@inject NavigationManager NavigationManager

<div class="brand-row">
    <a class="brand" href="dashboard"><span class="brand-mark">SF</span><span>StockFlow<small>RETAIL OS</small></span></a>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column" aria-label="Primary navigation">
        <p class="nav-label">WORKSPACE</p>
        <div class="nav-item"><NavLink class="nav-link" href="dashboard"><span class="nav-icon" aria-hidden="true">DB</span><span>Dashboard</span></NavLink></div>
        <div class="nav-item"><NavLink class="nav-link" href="pos"><span class="nav-icon" aria-hidden="true">PS</span><span>Point of Sale</span><span class="nav-badge">LIVE</span></NavLink></div>
        <div class="nav-item"><NavLink class="nav-link" href="orders"><span class="nav-icon" aria-hidden="true">OR</span><span>Orders</span></NavLink></div>

        <p class="nav-label">MANAGEMENT</p>
        <div class="nav-item"><NavLink class="nav-link" href="products"><span class="nav-icon" aria-hidden="true">PR</span><span>Products</span></NavLink></div>
        <div class="nav-item"><NavLink class="nav-link" href="inventory"><span class="nav-icon" aria-hidden="true">IN</span><span>Inventory</span></NavLink></div>
        <div class="nav-item"><NavLink class="nav-link" href="customers"><span class="nav-icon" aria-hidden="true">CU</span><span>Customers</span></NavLink></div>
        <div class="nav-item"><NavLink class="nav-link" href="reports"><span class="nav-icon" aria-hidden="true">RP</span><span>Reports</span></NavLink></div>
        <AuthorizeView Roles="Admin">
            <p class="nav-label">ADMINISTRATION</p>
            <div class="nav-item"><NavLink class="nav-link" href="admin" Match="NavLinkMatch.All"><span class="nav-icon" aria-hidden="true">AD</span><span>Admin overview</span><span class="nav-badge">ADMIN</span></NavLink></div>
            <div class="nav-item"><NavLink class="nav-link" href="admin/users"><span class="nav-icon" aria-hidden="true">TM</span><span>Team & roles</span></NavLink></div>
            <a class="sidebar-card" href="reports">
                <span class="sidebar-card-label">STORE PULSE</span>
                <strong>Review performance</strong>
                <small>Sales, profit & stock health</small>
                <span class="sidebar-card-arrow">→</span>
            </a>
        </AuthorizeView>

        <div class="sidebar-spacer"></div>
        <AuthorizeView>
            <Authorized>
                <div class="nav-item"><NavLink class="nav-link" href="Account/Manage"><span class="nav-icon" aria-hidden="true">AC</span><span>Account</span></NavLink></div>
                <div class="nav-item">
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                        <button type="submit" class="nav-link"><span class="nav-icon" aria-hidden="true">SO</span><span>Sign out</span></button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item"><NavLink class="nav-link" href="Account/Login"><span class="nav-icon" aria-hidden="true">SI</span><span>Sign in</span></NavLink></div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose() => NavigationManager.LocationChanged -= OnLocationChanged;
}

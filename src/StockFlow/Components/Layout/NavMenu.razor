@implements IDisposable

@inject NavigationManager NavigationManager

<div class="brand-row">
    <a class="brand" href="dashboard"><span class="brand-mark">S</span><span>StockFlow<small>SAH STORE</small></span></a>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <p class="nav-label">WORKSPACE</p>
        <div class="nav-item">
            <NavLink class="nav-link" href="dashboard">
                <span class="nav-icon" aria-hidden="true">⌂</span> Dashboard
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="pos">
                <span class="nav-icon" aria-hidden="true">▣</span> Point of Sale
                <span class="nav-badge">LIVE</span>
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="orders">
                <span class="nav-icon" aria-hidden="true">☷</span> Orders
            </NavLink>
        </div>
        <p class="nav-label">MANAGEMENT</p>
        <div class="nav-item">
            <NavLink class="nav-link" href="products">
                <span class="nav-icon" aria-hidden="true">◇</span> Products
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="inventory">
                <span class="nav-icon" aria-hidden="true">▦</span> Inventory
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="customers">
                <span class="nav-icon" aria-hidden="true">♙</span> Customers
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="reports">
                <span class="nav-icon" aria-hidden="true">⌁</span> Reports
            </NavLink>
        </div>
        <AuthorizeView Roles="Admin">
            <div class="nav-item">
                <NavLink class="nav-link" href="admin/users">
                    <span class="nav-icon" aria-hidden="true">⚙</span> Team & roles
                </NavLink>
            </div>
        </AuthorizeView>
        <div class="sidebar-spacer"></div>
        <AuthorizeView>
            <Authorized>
                <div class="nav-item">
                    <NavLink class="nav-link" href="Account/Manage">
                        <span class="nav-icon" aria-hidden="true">◎</span> Account
                    </NavLink>
                </div>
                <div class="nav-item">
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                        <button type="submit" class="nav-link">
                            <span class="nav-icon" aria-hidden="true">↪</span> Sign out
                        </button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item">
                    <NavLink class="nav-link" href="Account/Login">
                        <span class="nav-icon" aria-hidden="true">→</span> Sign in
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}

